{
  "$defs": {
    "Event": {
      "enum": [
        "session-start",
        "session-end",
        "before-tool",
        "after-tool",
        "on-prompt",
        "on-stop"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "event": {
      "$ref": "#/$defs/Event"
    },
    "native": {
      "additionalProperties": true,
      "type": "object"
    },
    "run": {
      "type": "string"
    }
  },
  "required": [
    "event",
    "run"
  ],
  "title": "Automation",
  "type": "object"
}
