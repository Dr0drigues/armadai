{
  "$defs": {
    "Delegation": {
      "enum": [
        "off",
        "strict"
      ],
      "type": "string"
    },
    "Grant": {
      "additionalProperties": false,
      "description": "A named permission level: native permission rules a user may switch on for a while.",
      "properties": {
        "allow": {
          "default": [],
          "description": "Native permission rules, e.g. `Bash(git push origin feature/*)`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "description": "Default end of the level: a step id, or `<flow>/<step>`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PackRef": {
      "additionalProperties": false,
      "description": "A pack this project is built on (reference mode): its files come from the cache,\nthe project's own files overlay them.",
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "description": "URL of the source (git repository or archive) holding the pack.",
          "type": "string"
        },
        "version": {
          "description": "`latest`, an exact version (`1.2.3`) or a semver range (`^1.3`, `~1.2`, `1`).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "version"
      ],
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "delegation": {
          "$ref": "#/$defs/Delegation"
        },
        "free_agents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "grants": {
          "additionalProperties": {
            "$ref": "#/$defs/Grant"
          },
          "description": "Named permission levels, activated by `armadai grant`.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "Ui": {
      "additionalProperties": false,
      "description": "Opt-in interface keys: absent or `false`, `link` writes nothing for them.",
      "properties": {
        "documents": {
          "description": "Project folders whose recent Markdown files the panel lists (default `docs`).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "panel": {
          "description": "Compile a Claude Code mod: a panel beside the chat with the flows and recent documents.",
          "type": "boolean"
        },
        "status_line": {
          "description": "Compile a Claude Code statusLine that shows the flow progress.",
          "type": "boolean"
        },
        "subagent_status_line": {
          "description": "Compile a Claude Code subagent status row that shows the step a subagent holds.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coordinator": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "native": {
      "additionalProperties": true,
      "type": "object"
    },
    "outputs": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "pack": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "targets": {
      "description": "Default link targets: claude, codex, copilot, opencode",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ui": {
      "$ref": "#/$defs/Ui"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "Manifest",
  "type": "object"
}
