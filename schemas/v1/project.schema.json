{
  "$defs": {
    "Delegation": {
      "enum": [
        "off",
        "strict"
      ],
      "type": "string"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "delegation": {
          "$ref": "#/$defs/Delegation"
        },
        "free_agents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coordinator": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "native": {
      "additionalProperties": true,
      "type": "object"
    },
    "outputs": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "targets": {
      "description": "Default link targets: claude, codex, copilot, opencode",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "Manifest",
  "type": "object"
}
