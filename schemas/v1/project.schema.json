{
  "$defs": {
    "Delegation": {
      "enum": [
        "off",
        "strict"
      ],
      "type": "string"
    },
    "PackRef": {
      "additionalProperties": false,
      "description": "A pack this project is built on (reference mode): its files come from the cache,\nthe project's own files overlay them.",
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "description": "URL of the source (git repository or archive) holding the pack.",
          "type": "string"
        },
        "version": {
          "description": "`latest`, an exact version (`1.2.3`) or a semver range (`^1.3`, `~1.2`, `1`).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "version"
      ],
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "delegation": {
          "$ref": "#/$defs/Delegation"
        },
        "free_agents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coordinator": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "native": {
      "additionalProperties": true,
      "type": "object"
    },
    "outputs": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "pack": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "targets": {
      "description": "Default link targets: claude, codex, copilot, opencode",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "Manifest",
  "type": "object"
}
