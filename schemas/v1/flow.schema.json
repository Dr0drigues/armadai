{
  "$defs": {
    "Link": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "SeqExplicit": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent"
      ],
      "type": "object"
    },
    "SeqItem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/SeqExplicit"
        }
      ],
      "description": "Element of the `sequence` shortcut."
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "on_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "states": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Raw flow as read from `flows/<id>.yaml`.",
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "type": "array"
    },
    "sequence": {
      "items": {
        "$ref": "#/$defs/SeqItem"
      },
      "type": "array"
    },
    "steps": {
      "additionalProperties": {
        "$ref": "#/$defs/Step"
      },
      "type": "object"
    }
  },
  "title": "FlowFile",
  "type": "object"
}
