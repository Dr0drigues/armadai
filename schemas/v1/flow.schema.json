{
  "$defs": {
    "Link": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "when": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "SeqExplicit": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent"
      ],
      "type": "object"
    },
    "SeqItem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/SeqExplicit"
        }
      ],
      "description": "Element of the `sequence` shortcut."
    },
    "SessionLink": {
      "additionalProperties": false,
      "description": "Where a flow's coordinator sends a question that is outside its scope.",
      "properties": {
        "to": {
          "description": "Name of the other session, as started with `claude --name`.",
          "type": "string"
        },
        "when": {
          "description": "When to write to it.",
          "type": "string"
        }
      },
      "required": [
        "to",
        "when"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "on_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "optional": {
          "description": "The step may never run: a flow can finish without it (never a start step).",
          "type": "boolean"
        },
        "states": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Raw flow as read from `flows/<id>.yaml`.",
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "type": "array"
    },
    "sequence": {
      "items": {
        "$ref": "#/$defs/SeqItem"
      },
      "type": "array"
    },
    "session_link": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionLink"
        },
        {
          "type": "null"
        }
      ],
      "description": "Another session (`claude --name <to>`) this flow's coordinator writes to, and when."
    },
    "start": {
      "description": "The step the flow begins with; needed when every step has an incoming link",
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "additionalProperties": {
        "$ref": "#/$defs/Step"
      },
      "type": "object"
    }
  },
  "title": "FlowFile",
  "type": "object"
}
