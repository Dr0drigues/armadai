{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentFront",
  "type": "object",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "description": {
      "type": "string"
    },
    "native": {
      "type": "object",
      "additionalProperties": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tier"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "description"
  ],
  "$defs": {
    "Cap": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "delegate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cap"
            },
            {
              "type": "null"
            }
          ]
        },
        "read": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cap"
            },
            {
              "type": "null"
            }
          ]
        },
        "shell": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cap"
            },
            {
              "type": "null"
            }
          ]
        },
        "web": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cap"
            },
            {
              "type": "null"
            }
          ]
        },
        "write": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cap"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Tier": {
      "type": "string",
      "enum": [
        "fast",
        "pro",
        "max"
      ]
    }
  }
}
